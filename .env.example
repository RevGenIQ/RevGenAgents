# ==============================================================================
# RevGenIQ OS - Environment Variables Template
# ==============================================================================

# Supabase Public Configuration (Browser-safe publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://kxbglnayyqifjggcgqvm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# Supabase Server Privileged Configuration (Server-side ONLY, never in browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Super Admin Direct Access Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_a_long_random_password
ADMIN_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# Session & JWT Configuration
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# LLM Providers (Server-side ONLY)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-3-5
LLM_PROVIDER=anthropic

# Research & Search Providers (Server-side ONLY)
TAVILY_API_KEY=your_tavily_api_key
SERPER_API_KEY=your_serper_api_key
BRAVE_API_KEY=

# Contact Enrichment & Verification Providers (Server-side ONLY)
APOLLO_API_KEY=your_apollo_api_key
ZEROBOUNCE_API_KEY=your_zerobounce_api_key
NEVERBOUNCE_API_KEY=

# App URL & Security
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Research & Rate Limit Budgets
MAX_SEARCHES_PER_RUN=150
MAX_PAGE_FETCHES_PER_RUN=200
MAX_LLM_CALLS_PER_RUN=300

# LangGraph Agent Engine (Server-side ONLY)
# Set AGENT_ENGINE=langgraph to run research through the checkpointed ProspectingGraph;
# any other value keeps the legacy researchRunner.
AGENT_ENGINE=legacy
# Postgres connection string for LangGraph checkpoints (Supabase direct or session-pooler URL)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
# Schema for checkpoint tables; keep it out of `public`, which Supabase exposes to the anon key
# AGENT_CHECKPOINT_SCHEMA=langgraph
# Shared secret for the internal POST /api/runs/[id]/continue call (min 32 chars)
AGENT_CONTINUE_SECRET=CHANGE_ME_openssl_rand_hex_32
# Optional tuning (defaults shown)
# AGENT_TIME_BUDGET_MS=240000
# AGENT_MAX_CONCURRENCY=4
# AGENT_MAX_QUERIES=6
# AGENT_MIN_FIT_SCORE=70
# AGENT_BUDGET_PER_LEAD_USD=1.5
