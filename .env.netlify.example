# ==============================================================================
# Hunt Smarter - Netlify Production Environment Variables
# Copy these keys into Netlify Site Settings > Environment Variables
# ==============================================================================

# Supabase Public Configuration (Browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# Supabase Server Privileged Configuration (Server-side ONLY)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Admin & Session Authentication
ADMIN_EMAIL=admin@huntsmarter.ai
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_SECRET_KEY=your_random_admin_secret_key_32_chars
JWT_SECRET=your_random_jwt_secret_32_chars

# LLM Providers (Server-side ONLY)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GROQ_API_KEY=your_groq_api_key
# LLM_PROVIDER_ORDER=openai,gemini,anthropic,groq

# Research & Search Providers (Server-side ONLY)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# Contact Enrichment & Verification Providers (Server-side ONLY)
APOLLO_API_KEY=
ZEROBOUNCE_API_KEY=

# App URL & Security
NEXT_PUBLIC_APP_URL=https://your-site.netlify.app
ALLOWED_ORIGINS=https://your-site.netlify.app

# Research & Rate Limit Budgets
MAX_SEARCHES_PER_RUN=150
MAX_PAGE_FETCHES_PER_RUN=200
MAX_LLM_CALLS_PER_RUN=300
